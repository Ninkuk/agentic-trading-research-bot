{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "mkdir -p public && { cp ../reports/data.json public/data.json 2>/dev/null || cp src/fixtures/data.json public/data.json; }",
