# Free API keys — each line's URL is where to get that key. Only three
# sources need one; everything else (SEC, FINRA, CBOE, Treasury, NY Fed,
# calendars) works with no key at all.
FRED_API_KEY=ZZ_FRED_API_KEY_ZZ       # St. Louis Fed (macro/regime reader) — https://fred.stlouisfed.org/docs/api/api_key.html
CFTC_APP_TOKEN=ZZ_CFTC_APP_TOKEN_ZZ   # optional Socrata app token (lifts rate limits; not required) — https://publicreporting.cftc.gov/profile/edit/developer_settings
EIA_API_KEY=ZZ_EIA_API_KEY_ZZ         # EIA Open Data — https://www.eia.gov/opendata/register.php
NASS_API_KEY=ZZ_NASS_API_KEY_ZZ       # USDA NASS Quick Stats — https://quickstats.nass.usda.gov/api
HEALTHCHECK_URL=ZZ_HEALTHCHECK_URL_ZZ # optional; dead-man's switch pinged by the nightly dashboard job — https://healthchecks.io

# Nightly autonomous research loop (deploy/launchd/research_nightly.py).
# All optional; defaults shown. Set RESEARCH_NIGHTLY_MAX=0 to disable.
#RESEARCH_NIGHTLY_MAX=3
#RESEARCH_STALE_DAYS=30
#RESEARCH_NIGHTLY_MODEL=opus

# Market-open order execution (main.py orders / order_execution.sh). All four
# required before the orders dispatcher will plan anything; values stay out
# of the public repo on purpose (they disclose account scale). catalog.py's
# committed hard ceilings bound the two notional caps.
ROBINHOOD_ACCOUNT_NUMBER=ZZ_ACCOUNT_ZZ  # the account orders are pinned to (never defaulted from get_accounts)
ORDERS_MAX_ORDER_NOTIONAL=ZZ_DOLLARS_ZZ # per-order dollar cap
ORDERS_MAX_DAILY_NOTIONAL=ZZ_DOLLARS_ZZ # per-morning dollar cap (sum over the plan)
ORDERS_CASH_FLOOR=ZZ_DOLLARS_ZZ         # settled cash that must remain after all planned buys
# ORDERS_GO_LIVE=1 — NEVER set here; pass one-shot at install time, after the
# first-run verification (see .claude/skills/queue-order), to arm the launchd job.
